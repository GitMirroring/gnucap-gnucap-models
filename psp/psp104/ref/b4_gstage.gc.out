// ******** psp104 nmos paramset ********
// lukas deutz 2025
paramset N1 PSP104VA;
   parameter real l=1.0u;
   parameter real w=1.0u;
   parameter integer nf=1;
   parameter real ad=1.0e-12;
   parameter real pd=1.0e-6;
   parameter real as=1.0e-12;
   parameter real ps=1.0e-6;
   parameter real sa=0.0;
   parameter real sb=0.0;
   parameter real sd=0.0;
 .TYPE=1; .L=l; .W=w; .NF=nf; .AD=ad; .PD=pd; .AS=as; .PS=ps; .SA=sa; .SB=sb; .SD=sd;
endparamset

// ******** psp104 pmos paramset ********
// lukas deutz 2025
paramset P1 PSP104VA;
   parameter real l=1.0u;
   parameter real w=1.0u;
   parameter integer nf=1;
   parameter real ad=1.0e-12;
   parameter real pd=1.0e-6;
   parameter real as=1.0e-12;
   parameter real ps=1.0e-6;
   parameter real sa=0.0;
   parameter real sb=0.0;
   parameter real sd=0.0;
 .TYPE=(- 1); .L=l; .W=w; .NF=nf; .AD=ad; .PD=pd; .AS=as; .PS=ps; .SA=sa; .SB=sb; .SD=sd;
endparamset

//* One-shot trigger (tran) ported from BSIM481/benchmark_test/gstage.b4
//* Enable verilog mode
ground \0 ;
resistor #(.r(100k)) Rsource (.p(in),.n(g));
resistor #(.r(25k)) Rload (.p(d),.n(vdd));
N1 #(.w(4u),.l(0.09u)) M1 (.d(d),.g(g),.s(\0 ),.b(\0 ));
vsource #(.dc(1.8)) Vdd (.p(vdd),.n(\0 ));
vsine #(.dc(1.2),.mag(0.1)) Vin (.p(in),.n(\0 ));
