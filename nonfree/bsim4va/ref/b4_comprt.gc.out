// Voltage constraints needed to help initial convergence
// Constraints can be omitted when using the Berkeley BSIM483 model variant
// Declare ground
ground \0 ;
module nfet (.d(d),.g(g),.s(s),.b(b));
    parameter real w;
    parameter real l;
  nch #(.l(l),.w(w)) N (.d(d),.g(g),.s(s),.b(b));
endmodule // nfet

module pfet (.d(d),.g(g),.s(s),.b(b));
    parameter real l;
    parameter real w;
  pch #(.l(l),.w(w)) N (.d(d),.g(g),.s(s),.b(b));
endmodule // pfet

// Stabilizing capacitors
capacitor #(.c(30f)) CQ (.p(Qnot),.n(\0 ));
capacitor #(.c(10f)) CL (.p(Lnot),.n(\0 ));
// Stag4 : Output Buffering
// Buffers to drive output loads and provide clean signals
pfet #(.l(0.2u),.w(3.6u)) MQLO (.d(out_q),.g(Qnot),.s(dd),.b(dd));
nfet #(.l(0.2u),.w(1.8u)) MQL1 (.d(out_q),.g(Qnot),.s(\0 ),.b(\0 ));
pfet #(.l(0.2u),.w(3.6u)) MLTO (.d(out_l),.g(Lnot),.s(dd),.b(dd));
nfet #(.l(0.2u),.w(1.8u)) MLT1 (.d(out_l),.g(Lnot),.s(\0 ),.b(\0 ));
// Stage 3: Result Generation
// Combines results from previous stage
pfet #(.l(3.6u),.w(3.6u)) M11 (.d(Qnot),.g(\0 ),.s(dd),.b(dd));
nfet #(.l(0.2u),.w(1.8u)) M12 (.d(Qnot),.g(AorBnot),.s(nor3_mid),.b(\0 ));
nfet #(.l(0.2u),.w(1.8u)) M13 (.d(nor3_mid),.g(Lnot),.s(\0 ),.b(\0 ));
// Stage 2: Comparison logic
// Two NOR gates for comparison operations
// NOR1: Detects when B=1 and A=0
pfet #(.l(3.6u),.w(1.8u)) M5 (.d(AorBnot),.g(\0 ),.s(dd),.b(dd));
nfet #(.l(0.2u),.w(1.8u)) M6 (.d(AorBnot),.g(B),.s(nor1_mid),.b(\0 ));
nfet #(.l(0.2u),.w(1.8u)) M7 (.d(nor1_mid),.g(Anot),.s(\0 ),.b(\0 ));
// NOR2: Detects when B=0 and A=1
pfet #(.l(3.6u),.w(1.8u)) M8 (.d(Lnot),.g(\0 ),.s(dd),.b(dd));
nfet #(.l(0.2u),.w(1.8u)) M9 (.d(Lnot),.g(Bnot),.s(nor2_mid),.b(\0 ));
nfet #(.l(0.2u),.w(1.8u)) M10 (.d(nor2_mid),.g(A),.s(\0 ),.b(\0 ));
// State 1: Input Processing
// Input inverters to generate complementary signals
// Invert A
pfet #(.l(0.2u),.w(3.6u)) M1 (.d(Anot),.g(A),.s(dd),.b(dd));
nfet #(.l(0.2u),.w(1.8u)) M2 (.d(Anot),.g(A),.s(\0 ),.b(\0 ));
// Invert B
pfet #(.l(0.2u),.w(3.6u)) M3 (.d(Bnot),.g(B),.s(dd),.b(dd));
nfet #(.l(0.2u),.w(1.8u)) M4 (.d(Bnot),.g(B),.s(\0 ),.b(\0 ));
// Power supply and inputs
vsource #(.dc(1.8)) vcc (.p(dd),.n(\0 ));
// Signal A: periodic pulse that switches between 0V (logic '0') and 1.8V (logic '1')
vpulse #(.val0(0.0),.val1(1.8),.td(10n),.rise(0.1n),.fall(0.1n),.width(15n),.period(30n)) va (.p(A),.n(\0 ));
// Signal B: Constant DC voltage of 0V (logic '0')
vsource #(.dc(0.0)) vb (.p(B),.n(\0 ));
// Simulation control
#Time       v(A)       v(B)       v(out_l)   v(out_q)   iter(0)   
open circuit: internal node 123
open circuit: internal node 128
