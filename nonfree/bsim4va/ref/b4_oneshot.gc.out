// Voltage constraints needed to help initial convergence
// Constraints can be omitted when using the Berkeley BSIM483 model variant
// Declare ground
ground \0 ;
module nfet (.d(d),.g(g),.s(s),.b(b));
    parameter real w;
    parameter real l;
  nch #(.l(l),.w(w)) N (.d(d),.g(g),.s(s),.b(b));
endmodule // nfet

module pfet (.d(d),.g(g),.s(s),.b(b));
    parameter real l;
    parameter real w;
  pch #(.l(l),.w(w)) N (.d(d),.g(g),.s(s),.b(b));
endmodule // pfet

// Power supply
vsource #(.dc(1.8)) vcc (.p(dd),.n(\0 ));
// Input signal
vpulse #(.val0(0.0),.val1(1.8),.td(1n),.rise(0.1n),.fall(0.1n),.width(0.8n),.period(5n)) vin (.p(in),.n(\0 ));
// Stage1 : Double Inverter Buffer
// First inverter: Converts input to out1
pfet #(.l(0.2u),.w(3.6u)) Md1 (.d(out1),.g(in),.s(dd),.b(dd));
nfet #(.l(0.2u),.w(1.8u)) Md2 (.d(out1),.g(in),.s(\0 ),.b(\0 ));
// Second inverter: Converts out1 to signal A
pfet #(.l(0.2u),.w(3.6u)) Md3 (.d(A),.g(out1),.s(dd),.b(dd));
nfet #(.l(0.2u),.w(1.8u)) Md4 (.d(A),.g(out1),.s(\0 ),.b(\0 ));
// Load capacitors fors stability
capacitor #(.c(100f)) c_out1 (.p(out1),.n(\0 ));
capacitor #(.c(100f)) c_A (.p(A),.n(\0 ));
// Stage 2: Signal processing
// Inverter for signal A to generate Anot
pfet #(.l(0.2u),.w(3.6u)) M1 (.d(Anot),.g(A),.s(dd),.b(dd));
nfet #(.l(0.2u),.w(1.8u)) M2 (.d(Anot),.g(A),.s(\0 ),.b(\0 ));
// Inverter for input to generate Bnot
pfet #(.l(0.2u),.w(3.6u)) M3 (.d(Bnot),.g(in),.s(dd),.b(dd));
nfet #(.l(0.2u),.w(1.8u)) M4 (.d(Bnot),.g(in),.s(\0 ),.b(\0 ));
// First NOR Gate: AorBnot = (in + Anot)'
pfet #(.l(3.6u),.w(1.8u)) M5 (.d(AorBnot),.g(\0 ),.s(dd),.b(dd));
nfet #(.l(0.2u),.w(1.8u)) M6 (.d(AorBnot),.g(in),.s(in_Anot_j),.b(\0 ));
nfet #(.l(0.2u),.w(1.8u)) M7 (.d(in_Anot_j),.g(Anot),.s(\0 ),.b(\0 ));
// Second NOR Gate: Lnot = (Bnot + A)'
pfet #(.l(3.6u),.w(1.8u)) M8 (.d(Lnot),.g(\0 ),.s(dd),.b(dd));
nfet #(.l(0.2u),.w(1.8u)) M9 (.d(Lnot),.g(Bnot),.s(bnot_a_j),.b(\0 ));
nfet #(.l(0.2u),.w(1.8u)) M10 (.d(bnot_a_j),.g(A),.s(\0 ),.b(\0 ));
// Fnial NOR Gate: out = (AorBnot + Lnot)'
pfet #(.l(3.6u),.w(3.6u)) M11 (.d(out),.g(\0 ),.s(dd),.b(dd));
nfet #(.l(0.2u),.w(1.8u)) M12 (.d(out),.g(AorBnot),.s(aorb_lnot_j),.b(\0 ));
nfet #(.l(0.2u),.w(1.8u)) M13 (.d(aorb_lnot_j),.g(Lnot),.s(\0 ),.b(\0 ));
// Simulation control
#Time       v(in)      v(out)     iter(0)   
