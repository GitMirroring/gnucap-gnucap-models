verilog
load mgsim
load ../rram_v_1_0_0.so

ground \0 ;
options trtol=1

// "dynamic" mode. w/noise
parameter delta_gap=1e-4;
parameter delta_gap=0.05
parameter model_switch=1;
parameter gap_ini = 19e-10;

rram_v_1_0_0 #(.time_step(1e-6) .gap_ini(gap_ini), .model_switch(model_switch), .deltaGap0(delta_gap) X1(in, \0 );

parameter model_switch=1;

spice
*Pulse SET
.parameter pv=1.8
Vin in 0 pulse 0 {pv}  10ps   10ps  10ps  100ns 200ns
.print tran v(nodes) i(Vin)
.tran 205ns basic


*Pulse RESET
.parameter gap_ini = 2e-10
*.delete Vin
*Vin in 0 pulse 0 -1.3  10ps   10ps  10ps  100ns 200ns
.parameter pv=-1.3
*.tran tstep tstop tstart delmax
.print tran v(nodes) i(Vin)
.tran 0 205ns basic
.end
